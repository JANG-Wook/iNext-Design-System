    "interaction": {
      "$description": "상호작용 상태의 색 — 포커스 링(`focus`), 비활성(`inactive`·`disable`), 상태 오버레이(`overlay`). 강도(불투명도)는 primitive `interaction.opacity` 가 갖고 있고 여기서는 색만 정한다.",
      "inactive": {
        "$type": "color",
        "$value": "{color.gray.500}",
        "$description": "비활성 컨트롤의 전경색 — 아이콘·테두리처럼 \"지금 쓸 수 없음\"을 색으로 알리는 자리. 글자에는 `label.disable` 을 쓴다. 비활성 요소라 대비 검사에서 제외된다(KWCAG 5.4.3 예외)."
      },
      "disable": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$description": "비활성 컨트롤의 면색 — 눌리지 않는 버튼·입력 필드의 배경. 위에 올라가는 글자는 `label.disable` 이며, 둘 다 대비 검사 대상이 아니다."
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue.600}",
        "$description": "키보드 포커스 링 색. KWCAG 6.1.2(초점은 시각적으로 구별) · WCAG 2.4.7 대응. 배경 대비 3:1 이상을 유지한다."
      },
      "overlay": {
        "$description": "상태 오버레이 색 — base 색 + `interaction.opacity` 강도. 테마가 아니라 **얹히는 면의 밝기**로 고른다: 밝은 면엔 `darken`, 어두운 면엔 `lighten`. `primary` 처럼 테마와 반대로 뒤집히는 면이 있어 중립 회색 하나로는 방향이 맞지 않는다(DECISIONS 0-14). base 가 두 테마에서 같은 것은 의도이며 `color.static` 이 같은 성격이다.",
        "darken": {
          "hovered": {
            "$type": "color",
            "$value": "{color.gray.1000}",
            "$description": "밝은 면 위 hover 상태 오버레이. 면을 어둡게 한다. 강도는 `interaction.opacity.normal.hovered` 를 따른다.",
            "$extensions": {
              "net.infobank.ds.alpha": "{interaction.opacity.normal.hovered}"
            }
          },
          "focused": {
            "$type": "color",
            "$value": "{color.gray.1000}",
            "$description": "밝은 면 위 focus 상태 오버레이. 면을 어둡게 한다. 강도는 `interaction.opacity.normal.focused` 를 따른다.",
            "$extensions": {
              "net.infobank.ds.alpha": "{interaction.opacity.normal.focused}"
            }
          },
          "pressed": {
            "$type": "color",
            "$value": "{color.gray.1000}",
            "$description": "밝은 면 위 press 상태 오버레이. 면을 어둡게 한다. 강도는 `interaction.opacity.normal.pressed` 를 따른다.",
            "$extensions": {
              "net.infobank.ds.alpha": "{interaction.opacity.normal.pressed}"
            }
          }
        },
        "lighten": {
          "hovered": {
            "$type": "color",
            "$value": "{color.gray.0}",
            "$description": "어두운 면 위 hover 상태 오버레이. 면을 밝게 한다. 강도는 `interaction.opacity.normal.hovered` 를 따른다.",
            "$extensions": {
              "net.infobank.ds.alpha": "{interaction.opacity.normal.hovered}"
            }
          },
          "focused": {
            "$type": "color",
            "$value": "{color.gray.0}",
            "$description": "어두운 면 위 focus 상태 오버레이. 면을 밝게 한다. 강도는 `interaction.opacity.normal.focused` 를 따른다.",
            "$extensions": {
              "net.infobank.ds.alpha": "{interaction.opacity.normal.focused}"
            }
          },
          "pressed": {
            "$type": "color",
            "$value": "{color.gray.0}",
            "$description": "어두운 면 위 press 상태 오버레이. 면을 밝게 한다. 강도는 `interaction.opacity.normal.pressed` 를 따른다.",
            "$extensions": {
              "net.infobank.ds.alpha": "{interaction.opacity.normal.pressed}"
            }
          }
        }
      }
